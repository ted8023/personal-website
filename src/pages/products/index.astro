---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sections } from '../../data/sections';

const s = sections.find(s => s.slug === 'products')!;
const all = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const active  = all.filter(p => p.data.status !== '已下线');
const archive = all.filter(p => p.data.status === '已下线');
---
<BaseLayout title="产品 · 阿秋" accent={s.accent}>
  <a class="back" href="/">← 回首页</a>

  <!-- Masthead -->
  <div class="masthead reveal">
    <span class="mh-ghost" aria-hidden="true">{s.en[0]}</span>
    <p class="mh-en">{s.en}</p>
    <h1 class="mh-cn">{s.mhCn}</h1>
    <p class="mh-desc">{s.mhDesc}</p>
    <div class="mh-meta">
      {s.mhMeta.map(t => <span class="tag">{t}</span>)}
    </div>
  </div>

  <!-- Active / featured products -->
  {active.length > 0 && (
    <>
      <p class="row-label">进行中</p>
      <div class="card-grid">
        {active.map(p => (
          <a
            class="card reveal"
            href={p.data.url ?? '#'}
            target={p.data.url ? '_blank' : undefined}
            rel={p.data.url ? 'noopener noreferrer' : undefined}
          >
            <div class="c-bar" aria-hidden="true"></div>
            <div class="c-top">
              <span class="c-chip">{p.data.type}</span>
              <span class="c-status">{p.data.status}</span>
            </div>
            <div class="c-name">{p.data.title}</div>
            <p class="c-desc">{p.data.summary}</p>
            <div class="c-foot">
              {p.data.tech.slice(0, 3).join(' · ')}
              {p.data.url && <span class="arr">→</span>}
            </div>
          </a>
        ))}
      </div>
    </>
  )}

  <!-- Archive -->
  {archive.length > 0 && (
    <>
      <p class="row-label">早期实验</p>
      <div class="card-grid">
        {archive.map(p => (
          <div class="card reveal" style="opacity:.7;">
            <div class="c-bar" aria-hidden="true"></div>
            <div class="c-top">
              <span class="c-chip">{p.data.type}</span>
              <span class="c-status">{p.data.status}</span>
            </div>
            <div class="c-name">{p.data.title}</div>
            <p class="c-desc">{p.data.summary}</p>
            <div class="c-foot">{p.data.tech.slice(0, 3).join(' · ')}</div>
          </div>
        ))}
      </div>
    </>
  )}
</BaseLayout>
