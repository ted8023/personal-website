---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sections } from '../../data/sections';

const s = sections.find(s => s.slug === 'writing')!;

const raw = await getCollection('writing');
const posts = raw.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const fmtDate = (d: Date) =>
  `${d.getFullYear()}·${String(d.getMonth() + 1).padStart(2, '0')}`;

// Estimate reading time from body length (~300 chars/min for Chinese)
const readMin = (body: string) => Math.max(1, Math.round(body.length / 300));
---
<BaseLayout title="写作 · 阿秋" accent={s.accent}>
  <a class="back" href="/">← 回首页</a>

  <div class="masthead reveal">
    <span class="mh-ghost" aria-hidden="true">{s.en[0]}</span>
    <p class="mh-en">{s.en}</p>
    <h1 class="mh-cn">{s.mhCn}</h1>
    <p class="mh-desc">{s.mhDesc}</p>
    <div class="mh-meta">
      {s.mhMeta.map(t => <span class="tag">{t}</span>)}
    </div>
  </div>

  <nav class="post-list" aria-label="文章列表">
    {posts.map((p, i) => (
      <a class="post reveal" href={`/writing/${p.id}`} data-delay={i * 60}>
        <span class="p-num">{String(posts.length - i).padStart(2, '0')}</span>
        <div class="p-body">
          <div class="p-title">
            {p.data.title}
            <span class="p-arrow">↗</span>
          </div>
          {p.data.summary && <p class="p-ex">{p.data.summary}</p>}
        </div>
        <span class="p-meta">
          {fmtDate(p.data.publishDate)}<br />
          {readMin(p.body ?? '')} 分钟
        </span>
      </a>
    ))}
  </nav>
</BaseLayout>
