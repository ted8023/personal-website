---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sections } from '../../data/sections';
import { play } from '../../data/play';

const s = sections.find(s => s.slug === 'play')!;

const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);

// Build play cards from existing data
const playCards = [
  {
    emoji: '🎬',
    chip: '电影',
    name: '最近在看',
    desc: play.movies.map(m => `${m.title} ${stars(m.rating)}`).join('　'),
    foot: play.movies[0]?.note ?? '',
  },
  {
    emoji: '🐺',
    chip: '狼人杀',
    name: play.werewolf.role,
    desc: play.werewolf.style,
    foot: play.werewolf.highlights.join(' · '),
  },
  {
    emoji: '🎭',
    chip: '剧本杀',
    name: '最爱的本',
    desc: `玩过：${play.scriptMurder.played.join('、')}`,
    foot: `推荐：${play.scriptMurder.recommend[0] ?? ''}`,
  },
];
---
<BaseLayout title="玩 / 兴趣 · 阿秋" accent={s.accent}>
  <a class="back" href="/">← 回首页</a>

  <div class="masthead reveal">
    <span class="mh-ghost" aria-hidden="true">{s.en[0]}</span>
    <p class="mh-en">{s.en}</p>
    <h1 class="mh-cn">{s.mhCn}</h1>
    <p class="mh-desc">{s.mhDesc}</p>
    <div class="mh-meta">
      {s.mhMeta.map(t => <span class="tag">{t}</span>)}
    </div>
  </div>

  <div class="card-grid">
    {playCards.map((c, i) => (
      <div class="card reveal" data-delay={i * 80}>
        <div class="c-bar" aria-hidden="true"></div>
        <div class="c-top">
          <span class="emoji-big">{c.emoji}</span>
          <span class="c-chip">{c.chip}</span>
        </div>
        <div class="c-name">{c.name}</div>
        <p class="c-desc">{c.desc}</p>
        <div class="c-foot">{c.foot}</div>
      </div>
    ))}
  </div>
</BaseLayout>
