---
interface Props { greeting: string; lead: string; phrases: string[]; }
const { lead, phrases } = Astro.props;
---
<header class="hero">
  <div class="hero-top">
    <span class="dot" aria-hidden="true"></span>
    <span>此刻在线 · 一个爱折腾的产品人</span>
  </div>
  <h1>
    <span class="me">{lead}</span><span
      data-typer
      data-words={JSON.stringify(phrases)}
    ></span>
  </h1>
  <p class="hero-sub">
    你好，我是阿秋。做产品的时候认真到偏执，写东西的时候放松到跑题，剩下的时间用来<b>瞎想和瞎玩</b>。这张名片把这几件事一次摊开给你看。
  </p>
  <div class="hero-cta">
    <a class="btn-solid" href="/products" data-hot>看我做的东西 <span aria-hidden="true">→</span></a>
    <a class="btn-ghost" href="/about" data-hot>关于我（有彩蛋）</a>
  </div>
</header>

<script>
  function initTyper(el: HTMLElement) {
    let words: string[];
    try { words = JSON.parse(el.dataset.words ?? '[]'); } catch { return; }
    const word = document.createElement('span'); word.className = 'typer-word';
    const caret = document.createElement('span'); caret.className = 'typer-caret';
    el.append(word, caret);
    let wi = 0, ci = 0, deleting = false;
    function tick() {
      const full = words[wi];
      if (!deleting) {
        ci++;
        word.textContent = full.slice(0, ci);
        if (ci === full.length) { deleting = true; return setTimeout(tick, 1300); }
        setTimeout(tick, 95 + Math.random() * 60);
      } else {
        ci--;
        word.textContent = full.slice(0, ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; return setTimeout(tick, 260); }
        setTimeout(tick, 48);
      }
    }
    tick();
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('[data-typer]').forEach(initTyper);
  });
  if (document.readyState !== 'loading') {
    document.querySelectorAll<HTMLElement>('[data-typer]').forEach(initTyper);
  }
</script>

<style>
  .me { color: var(--ink); }
</style>
