---
import { sections } from '../data/sections';
const path = Astro.url.pathname;
---
<nav class="site-nav">
  <a class="brand" href="/">
    <span class="mark">秋</span>
    <span>阿秋<span class="en-label">&nbsp;/ Aqiu</span></span>
  </a>
  <div class="nav-links">
    {sections.map((s) => (
      <a
        href={`/${s.slug}`}
        class:list={[path.startsWith(`/${s.slug}`) && 'active', s.slug === 'thoughts' && 'hide-sm', s.slug === 'musings' && 'hide-sm']}
      >{s.label}</a>
    ))}
    <a href="/about" class:list={[path.startsWith('/about') && 'active']}>关于</a>
    <button class="theme-btn" onclick="toggleTheme()" aria-label="切换深浅色">◐</button>
  </div>
</nav>
