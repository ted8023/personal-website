---
import type { Section } from '../data/sections';
export interface Preview { title: string; meta?: string; }
interface Props { section: Section; previews: Preview[]; large?: boolean; delay?: number; }
const { section, previews, delay } = Astro.props;

const ghostLetter = section.en[0];
const cellClass = `c-${section.color}`;
---
<a
  href={`/${section.slug}`}
  class:list={['bento-cell reveal', cellClass]}
  data-hot
  data-delay={delay}
>
  <span class="cell-ghost" aria-hidden="true">{ghostLetter}</span>
  <div class="cell-head">
    <div>
      <div class="cell-en">{section.en}</div>
      <div class="cell-cn">{section.label}</div>
    </div>
    <span class="cell-arrow" aria-hidden="true">→</span>
  </div>
  <div class="cell-previews">
    {previews.map((p, i) => (
      <div class="pv">
        <span class="pv-idx">0{i + 1}</span>
        <span class="pv-t">{p.title}</span>
        {p.meta && <span class="pv-meta">{p.meta}</span>}
      </div>
    ))}
  </div>
</a>
